{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-09-04",
  "send_metrics": false,
  "dependencies_instrumentation": {
    "enabled": false,
  },
  "workers_dev": false,
  "preview_urls": true,
  "observability": {
    "enabled": false,
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "ethanbrosselard.com",
      "custom_domain": true,
    },
  ],
}
