{
  "name": "ethan-brosselard-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:container": "node scripts/validate-container.mjs",
    "check:links": "npm run build && node scripts/check-external-links.mjs",
    "validate:build": "node scripts/validate-build.mjs",
    "verify:site": "cross-env SITE_URL=https://portfolio.example npm run build && cross-env SITE_URL=https://portfolio.example npm run validate:build",
    "verify:no-site": "cross-env SITE_URL= npm run build && cross-env SITE_URL= npm run validate:build",
    "verify": "npm run format:check && npm run check && npm run verify:site && npm run verify:no-site"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.3",
    "@astrojs/sitemap": "3.7.3",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.1.3",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.62.1",
    "cross-env": "10.1.0",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.3"
  }
}
