---
import { profile } from "@/data/profile";
import { getCopy, routes, type Locale } from "@/i18n/copy";
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  locale: Locale;
  alternatePath: string;
}

const { locale, alternatePath } = Astro.props;
const t = getCopy(locale);
---

<BaseLayout
  {locale}
  currentPath={routes[locale].contact}
  {alternatePath}
  title={t.nav.contact}
  description={t.contact.intro}
  schemaType="ContactPage"
>
  <section class="page-hero section-grid contact-hero">
    <div class="container page-hero-inner reveal">
      <p class="eyebrow">{t.contact.eyebrow}</p>
      <h1>{t.contact.title}</h1>
      <p class="page-lead">{t.contact.intro}</p>
    </div>
  </section>

  <section class="section section--bordered">
    <div class="container contact-grid">
      <a class="contact-card contact-card--email reveal" href={`mailto:${profile.email}`}>
        <span>{t.contact.emailLabel}</span>
        <strong>{profile.email}</strong>
        <span aria-hidden="true">↗</span>
      </a>
      <div class="contact-card reveal">
        <span>{t.contact.socialLabel}</span>
        <div class="contact-socials">
          <a href={profile.socials.github} rel="me">GitHub ↗</a>
          <a href={profile.socials.linkedin} rel="me">LinkedIn ↗</a>
        </div>
      </div>
      <div class="contact-card reveal">
        <span>{t.contact.locationLabel}</span>
        <strong>{profile.location}</strong>
        <span>FR · EN</span>
      </div>
    </div>
    <p class="container privacy-note">{t.contact.note}</p>
  </section>
</BaseLayout>
