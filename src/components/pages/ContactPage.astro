---
import { profile } from "@/data/profile";
import PageHero from "@/components/layout/PageHero.astro";
import { getCopy, routes, type Locale } from "@/i18n/copy";
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  locale: Locale;
  alternatePath: string;
}

const { locale, alternatePath } = Astro.props;
const t = getCopy(locale);
---

<BaseLayout
  {locale}
  currentPath={routes[locale].contact}
  {alternatePath}
  title={t.nav.contact}
  description={t.contact.intro}
  schemaType="ContactPage"
  mainClass="contact-page"
>
  <PageHero class="contact-hero" eyebrow={t.contact.eyebrow} title={t.contact.title}>
    <div class="contact-hero-details">
      <p class="page-lead">{t.contact.intro}</p>
      <ul class="contact-hero-meta">
        <li>{profile.location}</li>
        <li>FR · EN</li>
      </ul>
      <div class="button-row contact-hero-actions">
        <a class="button button--primary" href={`mailto:${profile.email}`}>
          {t.home.contactCta}
        </a>
      </div>
    </div>
  </PageHero>

  <section class="section section--bordered contact-panel">
    <div class="container contact-grid">
      <div class="contact-card contact-card--email reveal">
        <span>{t.contact.emailLabel}</span>
        <strong>{profile.email}</strong>
        <div class="contact-email-actions">
          <button
            type="button"
            hidden
            data-copy-email
            data-email={profile.email}
            data-copied-label={t.contact.copiedEmail}
            data-copy-error-label={t.contact.copyEmailError}
            aria-controls="email-copy-status"
          >
            {t.contact.copyEmail}
          </button>
          <a href={`mailto:${profile.email}`}>
            {t.contact.openEmail}
            <span aria-hidden="true">↗</span>
          </a>
        </div>
        <p id="email-copy-status" role="status" aria-live="polite" aria-atomic="true"></p>
      </div>
      <div class="contact-card reveal">
        <span>{t.contact.socialLabel}</span>
        <div class="contact-socials">
          <a href={profile.socials.github} rel="me">GitHub ↗</a>
          <a href={profile.socials.linkedin} rel="me">LinkedIn ↗</a>
        </div>
      </div>
      <div class="contact-card reveal">
        <span>{t.contact.locationLabel}</span>
        <strong>{profile.location}</strong>
        <span>FR · EN</span>
      </div>
    </div>
    <p class="container privacy-note">{t.contact.note}</p>
  </section>
</BaseLayout>

<script>
  const copyEmailButtons = document.querySelectorAll<HTMLButtonElement>("[data-copy-email]");

  for (const button of copyEmailButtons) {
    if (typeof navigator.clipboard?.writeText !== "function" || button.dataset.ready === "true") {
      continue;
    }

    const status = document.getElementById(button.getAttribute("aria-controls") ?? "");
    if (!status) continue;

    button.dataset.ready = "true";
    button.hidden = false;

    button.addEventListener("click", async () => {
      const email = button.dataset.email;
      if (!email || button.disabled) return;

      button.disabled = true;
      status.textContent = "";

      try {
        await navigator.clipboard.writeText(email);
        status.textContent = button.dataset.copiedLabel ?? "";
      } catch {
        status.textContent = button.dataset.copyErrorLabel ?? "";
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
