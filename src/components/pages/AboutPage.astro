---
import { profile } from "@/data/profile";
import { getCopy, routes, type Locale } from "@/i18n/copy";
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  locale: Locale;
  alternatePath: string;
}

const { locale, alternatePath } = Astro.props;
const t = getCopy(locale);
---

<BaseLayout
  {locale}
  currentPath={routes[locale].about}
  {alternatePath}
  title={t.nav.about}
  description={t.about.lead}
  schemaType="ProfilePage"
>
  <section class="page-hero section-grid about-hero">
    <div class="container page-hero-inner reveal">
      <p class="eyebrow">{t.about.eyebrow}</p>
      <h1>{t.about.title}</h1>
      <p class="page-lead">{t.about.lead}</p>
    </div>
  </section>

  <section class="section section--bordered">
    <div class="container about-page-grid">
      <aside class="about-profile reveal" aria-label={profile.name}>
        <div class="about-profile-identity">
          <strong>{profile.brand}</strong>
          <span>{profile.name}</span>
        </div>
        <div class="about-profile-details">
          <p>{t.home.eyebrow}</p>
          <ul class="about-profile-links">
            <li>
              <a href={profile.socials.github} rel="me">
                GitHub
                <span aria-hidden="true">↗</span>
              </a>
            </li>
            <li>
              <a href={profile.socials.linkedin} rel="me">
                LinkedIn
                <span aria-hidden="true">↗</span>
              </a>
            </li>
            <li>
              <a href={`mailto:${profile.email}`}>
                {t.contact.emailLabel}
                <span aria-hidden="true">↗</span>
              </a>
            </li>
          </ul>
        </div>
        <ul class="about-profile-meta">
          <li>{profile.location}</li>
          <li>FR · EN</li>
        </ul>
      </aside>
      <ol class="about-story-list reveal">
        {
          t.about.paragraphs.map((paragraph, index) => (
            <li>
              <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <p>{paragraph}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container two-note-grid">
      <article class="note-card reveal">
        <p class="eyebrow">{t.about.nowLabel}</p>
        <p>{t.about.nowText}</p>
      </article>
      <article class="note-card reveal">
        <p class="eyebrow">{t.about.proofLabel}</p>
        <p>{t.about.proofText}</p>
      </article>
    </div>
  </section>
</BaseLayout>
