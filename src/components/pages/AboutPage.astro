---
import { profile } from "@/data/profile";
import { getCopy, routes, type Locale } from "@/i18n/copy";
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  locale: Locale;
  alternatePath: string;
}

const { locale, alternatePath } = Astro.props;
const t = getCopy(locale);
---

<BaseLayout
  {locale}
  currentPath={routes[locale].about}
  {alternatePath}
  title={t.nav.about}
  description={t.about.lead}
  schemaType="ProfilePage"
>
  <section class="page-hero section-grid about-hero">
    <div class="container about-hero-inner reveal">
      <div class="about-hero-heading">
        <p class="eyebrow">{t.about.eyebrow}</p>
        <span class="about-hero-signature" aria-hidden="true">{profile.brand}</span>
      </div>
      <div class="about-hero-copy">
        <h1>{t.about.title}</h1>
        <div class="about-hero-intro">
          <p class="page-lead">{t.about.lead}</p>
          <ul class="about-hero-meta" aria-label={t.about.eyebrow}>
            <li>{profile.name}</li>
            <li>{profile.location}</li>
            <li>FR · EN</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--bordered">
    <div class="container about-page-grid">
      <aside class="identity-card reveal">
        <div>
          <strong>{profile.name}</strong>
          <span>{profile.brand}</span>
        </div>
        <p>{profile.location}</p>
        <p>FR · EN</p>
      </aside>
      <div class="prose-large reveal">
        {t.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container two-note-grid">
      <article class="note-card reveal">
        <p class="eyebrow">{t.about.nowLabel}</p>
        <p>{t.about.nowText}</p>
      </article>
      <article class="note-card reveal">
        <p class="eyebrow">{t.about.proofLabel}</p>
        <p>{t.about.proofText}</p>
      </article>
    </div>
  </section>
</BaseLayout>
