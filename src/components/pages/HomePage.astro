---
import { getCollection } from "astro:content";
import ContactBand from "@/components/layout/ContactBand.astro";
import ProjectCard from "@/components/projects/ProjectCard.astro";
import { profile } from "@/data/profile";
import { getResume } from "@/data/resume";
import { getCopy, routes, type Locale } from "@/i18n/copy";
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  locale: Locale;
  alternatePath: string;
}

const { locale, alternatePath } = Astro.props;
const t = getCopy(locale);
const localizedRoutes = routes[locale];
const resume = getResume(locale);
const experience = resume.experience;
const [titleBefore, titleAfter] = t.home.title.split(t.home.titleEmphasis);
const projects = (
  await getCollection(
    "projects",
    ({ data }) => data.locale === locale && data.publication !== "draft" && data.featured,
  )
).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  locale={locale}
  currentPath={localizedRoutes.home}
  {alternatePath}
  schemaType="ProfilePage"
>
  <section class="hero section-grid">
    <div class="container hero-grid">
      <div class="hero-copy reveal">
        <p class="eyebrow hero-eyebrow">{t.home.eyebrow}</p>
        <h1>
          {titleBefore}
          <span class="hero-title-emphasis">{t.home.titleEmphasis}</span>
          {titleAfter}
        </h1>
        <p class="hero-objective">{resume.objective}</p>
        <p class="hero-intro">{t.home.intro}</p>
        <div class="button-row">
          <a class="button button--primary" href={profile.resume[locale]} download>
            {t.home.resumePdfCta}
          </a>
          <a class="button button--secondary" href={`mailto:${profile.email}`}>
            {t.home.contactCta}
          </a>
        </div>
        <nav class="hero-quick-links" aria-label={t.home.quickLinksLabel}>
          <a href="#experience">{t.home.experienceCta}</a>
          <a href={localizedRoutes.projects}>{t.home.projectsCta}</a>
          <a href={profile.socials.github} rel="me">
            {" "}
            GitHub ↗{" "}
          </a>
          <a href={profile.socials.linkedin} rel="me">
            {" "}
            LinkedIn ↗{" "}
          </a>
        </nav>
      </div>

      <aside class="hero-field reveal" aria-labelledby="job-search-title">
        <div class="hero-field-grid" aria-hidden="true"></div>
        <div class="hero-panel-identity">
          <p class="hero-search-label">{t.home.searchLabel}</p>
          <h2 id="job-search-title">{t.home.searchTitle}</h2>
          <span>{profile.location}</span>
        </div>
        <div class="hero-search-copy">
          <p>{t.home.searchText}</p>
          <p class="hero-search-objective">{resume.objective}</p>
        </div>
        <div class="hero-panel-projects">
          <a href={localizedRoutes.resume}>
            <strong>{t.home.resumeOnlineCta}</strong>
            <span class="hero-panel-project-arrow" aria-hidden="true">
              ↗
            </span>
          </a>
          <a href={`mailto:${profile.email}`}>
            <strong>{t.home.contactCta}</strong>
            <span class="hero-panel-project-arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        </div>
      </aside>
    </div>
  </section>

  <section id="experience" class="section experience-section section--bordered">
    <div class="container section-heading section-heading--split reveal">
      <div>
        <p class="eyebrow">{t.home.experienceEyebrow}</p>
        <h2>{t.home.experienceTitle}</h2>
      </div>
      <p>{t.home.experienceIntro}</p>
    </div>
    <div class="container experience-list">
      {experience.map((entry) => (
        <article id={`experience-${entry.id}`} class="experience-card reveal">
          <div class="experience-card-heading">
            <div>
              <p class="eyebrow">{entry.organization}</p>
              <h3>{entry.title}</h3>
            </div>
            <p class="experience-period">{entry.period}</p>
          </div>
          <ul>
            {entry.highlights
              ?.filter((_, index) => entry.id !== "beyowi" || [0, 1, 4].includes(index))
              .map((highlight) => (
                <li>{highlight}</li>
              ))}
          </ul>
        </article>
      ))}
    </div>
    <div class="container experience-footer">
      <a class="text-link" href={localizedRoutes.resume}>
        {t.home.experienceMore}
        <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="container education-preview">
      <p class="eyebrow">{t.home.educationLabel}</p>
      <ul>
        {resume.education.map((entry) => (
          <li>
            <strong>{entry.title}</strong>
            <span>
              {entry.organization} · {entry.period}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section projects-section">
    <div class="container section-heading section-heading--split reveal">
      <div>
        <p class="eyebrow">{t.projects.eyebrow}</p>
        <h2>{t.home.selectedProjects}</h2>
      </div>
      <p>{t.home.selectedProjectsIntro}</p>
    </div>
    <div class="container project-list">
      {projects.map((entry) => (
        <ProjectCard {entry} {locale} />
      ))}
    </div>
  </section>

  <section class="section section--bordered fields-section">
    <div class="container section-heading section-heading--split reveal">
      <div>
        <p class="eyebrow">{t.home.signalLabel}</p>
        <h2>{t.home.fieldsTitle}</h2>
      </div>
      <p>{t.home.fieldsIntro}</p>
    </div>
    <div class="container field-grid">
      {t.home.fields.map((field) => (
        <article class="field-card reveal">
          <span class="field-index">{field.index}</span>
          <h3>{field.title}</h3>
          <p>{field.text}</p>
          <a class="text-link" href={field.href}>
            {field.linkLabel}
            <span aria-hidden="true">↗</span>
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="section section--bordered">
    <div class="container about-preview reveal">
      <div>
        <p class="eyebrow">{t.home.aboutEyebrow}</p>
        <h2>{t.home.aboutTitle}</h2>
      </div>
      <div class="about-preview-copy">
        <p class="body-large">{t.home.aboutText}</p>
        <a class="text-link" href={localizedRoutes.about}>
          {t.home.aboutCta}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <ContactBand {locale} />
</BaseLayout>
