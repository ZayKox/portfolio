---
import { getCollection } from "astro:content";
import ProjectCard from "@/components/projects/ProjectCard.astro";
import { profile } from "@/data/profile";
import { getCopy, routes, type Locale } from "@/i18n/copy";
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  locale: Locale;
  alternatePath: string;
}

const { locale, alternatePath } = Astro.props;
const t = getCopy(locale);
const localizedRoutes = routes[locale];
const projects = (
  await getCollection(
    "projects",
    ({ data }) => data.locale === locale && data.publication !== "draft" && data.featured,
  )
).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  locale={locale}
  currentPath={localizedRoutes.home}
  {alternatePath}
  schemaType="ProfilePage"
>
  <section class="hero section-grid">
    <div class="container hero-grid">
      <div class="hero-copy reveal">
        <p class="eyebrow hero-eyebrow">{t.home.eyebrow}</p>
        <h1>{t.home.title}</h1>
        <p class="hero-intro">{t.home.intro}</p>
        <div class="button-row">
          <a class="button button--primary" href={localizedRoutes.projects}>{t.home.projectsCta}</a>
          <a class="button button--secondary" href={profile.socials.github} rel="me">
            {t.home.githubCta}
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="hero-field" aria-hidden="true">
        <div class="hero-field-grid"></div>
        <div class="hero-halo"></div>
        <div class="hero-signature">
          <span class="hero-signature-wordmark">{profile.brand}</span>
          <span class="hero-signature-name">{profile.name}</span>
        </div>
        <span class="hero-node hero-node--web">WEB</span>
        <span class="hero-node hero-node--mobile">DATA</span>
        <span class="hero-node hero-node--systems">SYSTEMS</span>
        <span class="hero-node hero-node--ai">AI / NEXT</span>
        <div class="hero-field-caption">{t.home.signalLabel}</div>
      </div>
    </div>
  </section>

  <section class="section section--bordered">
    <div class="container section-heading section-heading--split reveal">
      <div>
        <p class="eyebrow">{t.home.signalLabel}</p>
        <h2>{t.home.fieldsTitle}</h2>
      </div>
      <p>{t.home.fieldsIntro}</p>
    </div>
    <div class="container field-grid">
      {
        t.home.fields.map((field) => (
          <article class="field-card reveal">
            <span class="field-index">{field.index}</span>
            <h3>{field.title}</h3>
            <p>{field.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section projects-section">
    <div class="container section-heading section-heading--split reveal">
      <div>
        <p class="eyebrow">{t.projects.eyebrow}</p>
        <h2>{t.home.selectedProjects}</h2>
      </div>
      <p>{t.home.selectedProjectsIntro}</p>
    </div>
    <div class="container project-list">
      {projects.map((entry, index) => <ProjectCard {entry} {locale} {index} />)}
    </div>
  </section>

  <section class="section section--bordered">
    <div class="container about-preview reveal">
      <div>
        <p class="eyebrow">{t.home.aboutEyebrow}</p>
        <h2>{t.home.aboutTitle}</h2>
      </div>
      <div class="about-preview-copy">
        <p class="body-large">{t.home.aboutText}</p>
        <div class="interest-line">
          <span>{t.home.interestsLabel}</span>
          <p>{t.home.interests}</p>
        </div>
        <a class="text-link" href={localizedRoutes.about}>
          {t.home.aboutCta}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section contact-band">
    <div class="container contact-band-inner reveal">
      <div>
        <p class="eyebrow">{t.nav.contact}</p>
        <h2>{t.home.contactTitle}</h2>
        <p>{t.home.contactText}</p>
      </div>
      <a class="button button--primary" href={`mailto:${profile.email}`}>{t.home.contactCta}</a>
    </div>
  </section>
</BaseLayout>
