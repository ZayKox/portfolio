---
import { profile } from "@/data/profile";
import PageHero from "@/components/layout/PageHero.astro";
import resume from "@/data/resume.json";
import { getCopy, routes, type Locale } from "@/i18n/copy";
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  locale: Locale;
  alternatePath: string;
}

const { locale, alternatePath } = Astro.props;
const t = getCopy(locale);
const document = resume[locale];
const resumeUrl = profile.resume[locale];
---

<BaseLayout
  {locale}
  currentPath={routes[locale].resume}
  {alternatePath}
  title={t.nav.resume}
  description={t.resume.intro}
>
  <PageHero class="resume-hero" eyebrow={t.resume.eyebrow} title={t.resume.title}>
    <div class="resume-hero-details">
      <p class="page-lead">{t.resume.intro}</p>
      <ul class="resume-hero-meta" aria-label={t.resume.contact}>
        <li>{document.role}</li>
        <li>{profile.location}</li>
      </ul>
      <div class="button-row resume-actions">
        <a class="button button--primary" href={resumeUrl} download>{t.resume.download}</a>
      </div>
    </div>
  </PageHero>

  <article class="container resume-document" aria-label={document.documentTitle}>
    <header class="resume-document-header">
      <div>
        <p class="eyebrow">{profile.brand}</p>
        <h2>{profile.name}</h2>
        <p class="resume-role">{document.role}</p>
      </div>
      <dl class="resume-contact-list">
        {
          document.contact.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.href ? <a href={item.href}>{item.value}</a> : item.value}</dd>
            </div>
          ))
        }
      </dl>
    </header>

    <p class="resume-summary">{document.summary}</p>

    <section class="resume-section">
      <h2>{t.resume.experience}</h2>
      <div class="resume-entry-list">
        {
          document.experience.map((entry) => (
            <article class="resume-entry">
              <div class="resume-entry-heading">
                <div>
                  <h3>{entry.title}</h3>
                  <p>{entry.organization}</p>
                </div>
                <p class="resume-entry-meta">
                  {entry.period}
                  {"location" in entry && entry.location && (
                    <>
                      <br />
                      {entry.location}
                    </>
                  )}
                </p>
              </div>
              {"summary" in entry && entry.summary && <p>{entry.summary}</p>}
              {"highlights" in entry && entry.highlights && (
                <ul>
                  {entry.highlights.map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              )}
              {"technologies" in entry && entry.technologies && (
                <p class="resume-technologies">{entry.technologies}</p>
              )}
            </article>
          ))
        }
      </div>
    </section>

    <section class="resume-section resume-section--education">
      <h2>{t.resume.education}</h2>
      <div class="resume-entry-list">
        {
          document.education.map((entry) => (
            <article class="resume-entry resume-entry--compact">
              <div class="resume-entry-heading">
                <div>
                  <h3>{entry.title}</h3>
                  <p>{entry.organization}</p>
                </div>
                <p class="resume-entry-meta">
                  {entry.period}
                  {"location" in entry && entry.location && (
                    <>
                      <br />
                      {entry.location}
                    </>
                  )}
                </p>
              </div>
              {"summary" in entry && entry.summary && <p>{entry.summary}</p>}
            </article>
          ))
        }
      </div>
    </section>

    <section class="resume-section">
      <h2>{t.resume.skills}</h2>
      <dl class="resume-skill-list">
        {
          document.skillGroups.map((group) => (
            <div>
              <dt>{group.category}</dt>
              <dd>{group.items}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="resume-section">
      <h2>{t.resume.languages}</h2>
      <dl class="resume-language-list">
        {
          document.languages.map((language) => (
            <div>
              <dt>{language.name}</dt>
              <dd>{language.level}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="resume-section">
      <h2>{t.resume.projects}</h2>
      <div class="resume-project-groups">
        {
          document.projectGroups.map((group) => (
            <div class="resume-project-group">
              <h3>{group.title}</h3>
              <div class="resume-project-list">
                {group.items.map((project) => (
                  <article>
                    <h4>{project.title}</h4>
                    <p>{project.description}</p>
                  </article>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </article>
</BaseLayout>
