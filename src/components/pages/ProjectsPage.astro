---
import { getCollection } from "astro:content";
import ProjectCard from "@/components/projects/ProjectCard.astro";
import { getCopy, routes, type Locale } from "@/i18n/copy";
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  locale: Locale;
  alternatePath: string;
}

const { locale, alternatePath } = Astro.props;
const t = getCopy(locale);
const projects = (
  await getCollection(
    "projects",
    ({ data }) => data.locale === locale && data.publication !== "draft",
  )
).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  {locale}
  currentPath={routes[locale].projects}
  {alternatePath}
  title={t.projects.eyebrow}
  description={t.projects.intro}
  schemaType="CollectionPage"
>
  <section class="page-hero section-grid projects-hero">
    <div class="container page-hero-inner reveal">
      <p class="eyebrow">{t.projects.eyebrow}</p>
      <h1>{t.projects.title}</h1>
      <p class="page-lead">{t.projects.intro}</p>
    </div>
  </section>
  <section class="section page-projects">
    <div class="container project-list">
      {projects.map((entry) => <ProjectCard {entry} {locale} headingLevel={2} />)}
    </div>
  </section>
</BaseLayout>
