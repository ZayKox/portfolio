---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getCopy, type Locale } from "@/i18n/copy";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  locale: Locale;
  detail?: { view: "library-entry" | "game-board"; alt: string };
}

const { src, alt, caption, locale, detail } = Astro.props;
const t = getCopy(locale);
---

<figure class="project-capture">
  <Image
    {src}
    {alt}
    widths={[480, 800, 1200]}
    sizes="(max-width: 52rem) calc(100vw - 2.5rem), 49rem"
    format="webp"
    quality={85}
    loading="lazy"
    decoding="async"
  />
  {detail && (
    <details class="capture-detail">
      <summary>{t.project.captureDetail}</summary>
      <div class:list={["capture-detail-frame", `capture-detail-frame--${detail.view}`]}>
        <img
          src={src.src}
          width={src.width}
          height={src.height}
          alt={detail.alt}
          loading="lazy"
          decoding="async"
        />
      </div>
    </details>
  )}
  <figcaption>
    <span>{caption}</span>
    <a class="text-link" href={src.src}>
      {t.project.enlargeCapture}
      <span aria-hidden="true">↗</span>
    </a>
  </figcaption>
</figure>
