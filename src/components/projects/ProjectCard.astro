---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "@/i18n/copy";
import { getCopy } from "@/i18n/copy";
import ProjectVisual from "./ProjectVisual.astro";

interface Props {
  entry: CollectionEntry<"projects">;
  locale: Locale;
  index: number;
  headingLevel?: 2 | 3;
}

const { entry, locale, index, headingLevel = 3 } = Astro.props;
const t = getCopy(locale);
const href = locale === "fr" ? `/projets/${entry.data.slug}/` : `/en/projects/${entry.data.slug}/`;
const Heading = headingLevel === 2 ? "h2" : "h3";
const visualLabel =
  entry.data.visual === "palimia"
    ? `PA, Film, Game, Manga, Anime, Stats, Series — ${t.projects.viewProject} — ${entry.data.title}`
    : `Reflex Rush, Merge Forge, Grid Duel — ${t.projects.viewProject} — ${entry.data.title}`;
---

<article class="project-card reveal">
  <a class="project-card-visual" href={href} aria-label={visualLabel}>
    <ProjectVisual visual={entry.data.visual} />
  </a>
  <div class="project-card-content">
    <div class="project-card-meta">
      <span>{String(index + 1).padStart(2, "0")}</span>
      <span>{entry.data.kind}</span>
    </div>
    <div class="project-card-heading">
      <div>
        <p class="eyebrow">{entry.data.eyebrow}</p>
        <Heading><a href={href}>{entry.data.title}</a></Heading>
      </div>
      <span class="status-pill">{t.projects.teaser}</span>
    </div>
    <p class="project-summary">{entry.data.summary}</p>
    <ul class="tag-list" aria-label={t.project.stack}>
      {entry.data.stack.slice(0, 5).map((technology) => <li>{technology}</li>)}
    </ul>
    <a class="text-link" href={href}>
      {t.projects.viewProject}
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>
