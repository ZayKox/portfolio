---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "@/i18n/copy";
import { getCopy } from "@/i18n/copy";
import ProjectVisual from "./ProjectVisual.astro";
import ProjectPreview from "./ProjectPreview.astro";

interface Props {
  entry: CollectionEntry<"projects">;
  locale: Locale;
  headingLevel?: 2 | 3;
}

const { entry, locale, headingLevel = 3 } = Astro.props;
const t = getCopy(locale);
const href = locale === "fr" ? `/projets/${entry.data.slug}/` : `/en/projects/${entry.data.slug}/`;
const Heading = headingLevel === 2 ? "h2" : "h3";
const actionLabel =
  entry.data.publication === "teaser" ? t.projects.teaser : t.projects.viewProject;
const visualLabel = `${entry.data.title} — ${actionLabel}`;
---

<article
  class:list={[
    "project-card",
    "reveal",
    { "project-card--teaser": entry.data.publication === "teaser" },
  ]}
>
  <a class="project-card-visual" href={href} aria-label={visualLabel}>
    {entry.data.slug === "palimia" || entry.data.slug === "ludosaic" ? (
      <ProjectPreview slug={entry.data.slug} {locale} />
    ) : (
      <ProjectVisual
        visual={entry.data.visual}
        title={entry.data.title}
        items={entry.data.visualItems ?? entry.data.stack}
        {locale}
      />
    )}
  </a>
  <div class="project-card-content">
    <div class="project-card-heading">
      <div>
        <p class="eyebrow">{entry.data.eyebrow}</p>
        <Heading>
          <a href={href}>{entry.data.title}</a>
        </Heading>
      </div>
    </div>
    <p class="project-summary">{entry.data.summary}</p>
    <p class="project-card-decision">
      <strong>{t.project.decision}</strong>
      {entry.data.cardDecision}
    </p>
    <p class="project-card-status">{entry.data.currentStatus}</p>
    <ul class="tag-list" aria-label={t.project.stack}>
      {entry.data.stack.slice(0, 5).map((technology) => (
        <li>{technology}</li>
      ))}
    </ul>
    <a class="text-link" href={href} aria-label={`${actionLabel} — ${entry.data.title}`}>
      {actionLabel}
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>
