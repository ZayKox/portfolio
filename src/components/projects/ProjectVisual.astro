---
interface Props {
  visual: "myverse" | "calls";
}

const { visual } = Astro.props;
---

<div class:list={["project-visual", `project-visual--${visual}`]} aria-hidden="true">
  {
    visual === "myverse" ? (
      <>
        <div class="visual-orbit visual-orbit--outer" />
        <div class="visual-orbit visual-orbit--inner" />
        <div class="visual-core">MV</div>
        <span class="media-node media-node--1">FILM</span>
        <span class="media-node media-node--2">GAME</span>
        <span class="media-node media-node--3">BOOK</span>
        <span class="media-node media-node--4">ANIME</span>
        <span class="media-node media-node--5">MANGA</span>
        <span class="media-node media-node--6">SERIES</span>
      </>
    ) : (
      <>
        <div class="call-number">+33 •• •• •• 42</div>
        <div class="call-path call-path--1">
          <span>ALLOW</span>
        </div>
        <div class="call-path call-path--2">
          <span>SILENCE</span>
        </div>
        <div class="call-path call-path--3">
          <span>BLOCK</span>
        </div>
        <div class="call-result">RULE / 04</div>
      </>
    )
  }
</div>
