---
import type { Locale } from "@/i18n/copy";

interface Props {
  visual: "palimia" | "ludosaic";
  locale: Locale;
}

const { visual, locale } = Astro.props;
const palimiaLabels =
  locale === "fr"
    ? {
        profile: "UN SEUL PROFIL",
        library: "BIBLIOTHÈQUE CULTURELLE",
        worlds: "TOUS VOS UNIVERS",
        media: ["FILM", "SÉRIES", "JEU", "ANIME", "MANGA"],
        actions: ["SUIVRE", "NOTER", "ORGANISER"],
      }
    : {
        profile: "ONE PROFILE",
        library: "CULTURAL LIBRARY",
        worlds: "ALL YOUR WORLDS",
        media: ["FILM", "SERIES", "GAME", "ANIME", "MANGA"],
        actions: ["TRACK", "RATE", "ORGANIZE"],
      };
---

<div class:list={["project-visual", `project-visual--${visual}`]} aria-hidden="true">
  {
    visual === "palimia" ? (
      <div class="palimia-library">
        <header class="palimia-library-bar">
          <strong>PALIMIA</strong>
          <span>{palimiaLabels.profile}</span>
        </header>
        <div class="palimia-library-heading">
          <div>
            <span>{palimiaLabels.library}</span>
            <strong>{palimiaLabels.worlds}</strong>
          </div>
          <span class="palimia-library-count">05</span>
        </div>
        <div class="palimia-library-shelf">
          {palimiaLabels.media.map((label) => (
            <div class="palimia-media-card">
              <span>{label}</span>
            </div>
          ))}
        </div>
        <div class="palimia-library-footer">
          {palimiaLabels.actions.map((label) => (
            <span>{label}</span>
          ))}
        </div>
      </div>
    ) : (
      <>
        <div class="game-tile game-tile--reflex">
          <span>01</span>REFLEX RUSH
        </div>
        <div class="game-tile game-tile--merge">
          <span>02</span>MERGE FORGE
        </div>
        <div class="game-tile game-tile--grid">
          <span>03</span>GRID DUEL
        </div>
        <div class="game-status">SOLO · DAILY · LOCAL · ONLINE</div>
      </>
    )
  }
</div>
