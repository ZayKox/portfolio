---
import { getCopy, type Locale } from "@/i18n/copy";

interface Props {
  visual: "cultural-library" | "game-tiles" | "infrastructure" | "typographic";
  title: string;
  items?: string[] | undefined;
  locale: Locale;
}

const { visual, locale, title, items = [] } = Astro.props;
const palimiaLabels = getCopy(locale).visual.library;
const infrastructureLabels = getCopy(locale).visual.infrastructure;
---

<div class:list={["project-visual", `project-visual--${visual}`]} aria-hidden="true">
  {visual === "cultural-library" ? (
    <div class="palimia-library">
      <header class="palimia-library-bar">
        <strong>{title}</strong>
        <span>{palimiaLabels.profile}</span>
      </header>
      <div class="palimia-library-heading">
        <div>
          <span>{palimiaLabels.library}</span>
          <strong>{palimiaLabels.worlds}</strong>
        </div>
        <span class="palimia-library-count">
          {String(palimiaLabels.media.length).padStart(2, "0")}
        </span>
      </div>
      <div class="palimia-library-shelf">
        {palimiaLabels.media.map((label) => (
          <div class="palimia-media-card">
            <span>{label}</span>
          </div>
        ))}
      </div>
      <div class="palimia-library-footer">
        {palimiaLabels.actions.map((label) => (
          <span>{label}</span>
        ))}
      </div>
    </div>
  ) : visual === "game-tiles" ? (
    <>
      {items.map((item, index) => (
        <div class:list={["game-tile", `game-tile--${["reflex", "merge", "grid"][index % 3]}`]}>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <strong>{item}</strong>
        </div>
      ))}
    </>
  ) : visual === "infrastructure" ? (
    <div class="infrastructure-blueprint">
      <div class="infrastructure-heading">
        <span class="infrastructure-mark">
          <i></i>
          <i></i>
          <i></i>
        </span>
        <span>{infrastructureLabels.heading}</span>
      </div>
      <div class="infrastructure-nodes">
        {items.map((item) => (
          <div class="infrastructure-node">
            <strong>{item}</strong>
            <span class="infrastructure-ports">
              <i></i>
              <i></i>
              <i></i>
            </span>
          </div>
        ))}
      </div>
      <div class="infrastructure-footer">{infrastructureLabels.footer}</div>
    </div>
  ) : (
    <strong class="project-visual-title">{title}</strong>
  )}
</div>
