---
interface Props {
  visual: "palimia" | "ludosaic";
}

const { visual } = Astro.props;
---

<div class:list={["project-visual", `project-visual--${visual}`]} aria-hidden="true">
  {
    visual === "palimia" ? (
      <>
        <div class="visual-orbit visual-orbit--outer" />
        <div class="visual-orbit visual-orbit--inner" />
        <div class="visual-core">PA</div>
        <span class="media-node media-node--1">FILM</span>
        <span class="media-node media-node--2">GAME</span>
        <span class="media-node media-node--3">MANGA</span>
        <span class="media-node media-node--4">ANIME</span>
        <span class="media-node media-node--5">STATS</span>
        <span class="media-node media-node--6">SERIES</span>
      </>
    ) : (
      <>
        <div class="game-tile game-tile--reflex">
          <span>01</span>REFLEX RUSH
        </div>
        <div class="game-tile game-tile--merge">
          <span>02</span>MERGE FORGE
        </div>
        <div class="game-tile game-tile--grid">
          <span>03</span>GRID DUEL
        </div>
        <div class="game-status">SOLO · DAILY · LOCAL · ONLINE</div>
      </>
    )
  }
</div>
