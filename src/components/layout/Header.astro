---
import { profile } from "@/data/profile";
import { getCopy, routes, type Locale } from "@/i18n/copy";

interface Props {
  locale: Locale;
  currentPath: string;
  alternatePath: string;
}

const { locale, currentPath, alternatePath } = Astro.props;
const t = getCopy(locale);
const localizedRoutes = routes[locale];
const items = [
  { label: t.nav.home, href: localizedRoutes.home },
  { label: t.nav.projects, href: localizedRoutes.projects },
  { label: t.nav.about, href: localizedRoutes.about },
  { label: t.nav.resume, href: localizedRoutes.resume },
  { label: t.nav.contact, href: localizedRoutes.contact },
];

const isActive = (href: string) =>
  href === localizedRoutes.home ? currentPath === href : currentPath.startsWith(href);
---

<header class="site-header" data-site-header>
  <div class="container header-inner">
    <a
      class="brand"
      href={localizedRoutes.home}
      aria-label={`${profile.brand} — ${profile.name} — ${t.nav.home}`}
    >
      <span class="brand-mark" aria-hidden="true"></span>
      <span>{profile.brand}</span>
    </a>

    <nav class="main-nav" aria-label={t.nav.label}>
      {
        items.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <a
        class="language-switch"
        href={alternatePath}
        lang={locale === "fr" ? "en" : "fr"}
        hreflang={locale === "fr" ? "en" : "fr"}
        aria-label={t.languageSwitchLabel}
      >
        {t.alternateLocale}
      </a>
      <select class="theme-select" aria-label={t.themeLabel} data-theme-select hidden>
        <option value="system">{t.themeSystem}</option>
        <option value="light">{t.themeLight}</option>
        <option value="dark">{t.themeDark}</option>
      </select>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  // Only keep a sticky header when its actual height can be reserved for focus/anchors.
  // Without JavaScript the header stays in the normal document flow.
  if (header) {
    const measureHeader = () => {
      const height = header.getBoundingClientRect().height;
      const sticky = height < window.innerHeight / 3;
      header.dataset.sticky = String(sticky);
      root.style.setProperty("--header-height", `${sticky ? height : 0}px`);
    };
    new ResizeObserver(measureHeader).observe(header);
    window.addEventListener("resize", measureHeader);
    measureHeader();
    document.addEventListener("focusin", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement) || target.closest(".site-header, .skip-link")) return;
      requestAnimationFrame(() => {
        if (document.activeElement !== target) return;
        const rect = target.getBoundingClientRect();
        const top = Math.max(0, header.getBoundingClientRect().bottom) + 12;
        const offset =
          rect.top < top
            ? rect.top - top
            : rect.bottom > innerHeight - 12
              ? rect.bottom - innerHeight + 12
              : 0;
        if (offset) window.scrollBy({ top: offset, behavior: "instant" });
      });
    });
  }

  const themeSelect = document.querySelector<HTMLSelectElement>("[data-theme-select]");
  if (themeSelect) {
    const systemPreference = matchMedia("(prefers-color-scheme: dark)");
    let visitorTheme: "light" | "dark" | "system" = "system";
    try {
      const savedTheme = localStorage.getItem("portfolio-theme");
      if (savedTheme === "light" || savedTheme === "dark") visitorTheme = savedTheme;
    } catch {
      // Blocked storage still permits a choice for this page.
    }

    function applyTheme() {
      root.classList.add("theme-switching");
      root.dataset.theme =
        visitorTheme === "system" ? (systemPreference.matches ? "dark" : "light") : visitorTheme;
      requestAnimationFrame(() => root.classList.remove("theme-switching"));
    }

    themeSelect.value = visitorTheme;
    applyTheme();
    themeSelect.hidden = false;
    systemPreference.addEventListener("change", () => {
      if (visitorTheme === "system") applyTheme();
    });
    themeSelect.addEventListener("change", () => {
      const value = themeSelect.value;
      visitorTheme = value === "light" || value === "dark" ? value : "system";
      applyTheme();
      try {
        if (visitorTheme === "system") localStorage.removeItem("portfolio-theme");
        else localStorage.setItem("portfolio-theme", visitorTheme);
      } catch {
        // The selected theme still applies for the current page.
      }
    });
  }
</script>
