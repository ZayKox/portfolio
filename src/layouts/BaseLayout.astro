---
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import { profile } from "@/data/profile";
import { getCopy, routes, type Locale } from "@/i18n/copy";
import "@/styles/global.css";

interface Props {
  locale: Locale;
  currentPath: string;
  alternatePath: string;
  title?: string;
  description?: string;
  schemaType?: "ProfilePage" | "CollectionPage" | "ContactPage" | "WebPage";
  noindex?: boolean;
  socialImage?: string;
  socialImageAlt?: string;
  mainClass?: string;
}

const {
  locale,
  currentPath,
  alternatePath,
  title,
  description,
  schemaType = "WebPage",
  noindex = false,
  socialImage = "/social-card.png",
  socialImageAlt,
  mainClass,
} = Astro.props;
const isNoindex = noindex || __SITE_NOINDEX__;
const robotsContent = __SITE_NOINDEX__
  ? "noindex, nofollow"
  : noindex
    ? "noindex, follow"
    : undefined;
const t = getCopy(locale);
const pageTitle = title ? `${title} — ${profile.name}` : t.meta.title;
const pageDescription = description ?? t.meta.description;
const canonical = !isNoindex && Astro.site ? new URL(currentPath, Astro.site) : undefined;
const currentUrl = canonical ?? currentPath;
const alternateUrl = Astro.site ? new URL(alternatePath, Astro.site) : alternatePath;
const defaultPath = locale === "fr" ? currentPath : alternatePath;
const defaultUrl = Astro.site ? new URL(defaultPath, Astro.site) : defaultPath;
const sitemapUrl =
  !isNoindex && Astro.site ? new URL("sitemap-index.xml", Astro.site).href : undefined;
const socialImageUrl =
  !isNoindex && Astro.site ? new URL(socialImage.replace(/^\//, ""), Astro.site).href : undefined;
const socialImageDescription = socialImageAlt ?? t.meta.socialImageAlt;
const personUrl = Astro.site ? new URL(routes[locale].home, Astro.site).href : undefined;
const person = {
  "@type": "Person",
  name: profile.name,
  homeLocation: {
    "@type": "Place",
    name: profile.location,
  },
  sameAs: [profile.socials.github, profile.socials.linkedin],
  ...(personUrl && { url: personUrl }),
};
const jsonLd = isNoindex
  ? undefined
  : schemaType === "ProfilePage"
    ? {
        "@context": "https://schema.org",
        "@type": schemaType,
        name: pageTitle,
        description: pageDescription,
        inLanguage: locale,
        mainEntity: person,
        ...(canonical && { url: canonical.href }),
      }
    : {
        "@context": "https://schema.org",
        "@type": schemaType,
        name: pageTitle,
        description: pageDescription,
        inLanguage: locale,
        author: person,
        ...(canonical && { url: canonical.href }),
      };
const jsonLdSource = jsonLd
  ? JSON.stringify(jsonLd)
      .replace(/</g, "\\u003c")
      .replace(/\u2028/g, "\\u2028")
      .replace(/\u2029/g, "\\u2029")
  : undefined;
const themeBootstrap =
  '(()=>{let savedTheme;try{savedTheme=localStorage.getItem("portfolio-theme")}catch{}const systemTheme=matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light";document.documentElement.dataset.theme=savedTheme==="light"||savedTheme==="dark"?savedTheme:systemTheme})()';
const scriptHash = async (source: string) => {
  const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(source));
  const base64 = btoa(String.fromCharCode(...new Uint8Array(digest)));
  return `sha256-${base64}` as `sha256-${string}`;
};

for (const source of [themeBootstrap, jsonLdSource]) {
  if (source) Astro.csp?.insertScriptHash(await scriptHash(source));
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#6d28d9" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={profile.name} />
    {robotsContent && <meta name="robots" content={robotsContent} />}
    {
      !isNoindex && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:title" content={pageTitle} />
          <meta property="og:description" content={pageDescription} />
          <meta property="og:site_name" content={profile.name} />
          <meta property="og:locale" content={locale === "fr" ? "fr_FR" : "en_US"} />
          <meta property="og:locale:alternate" content={locale === "fr" ? "en_US" : "fr_FR"} />
          {canonical && <meta property="og:url" content={canonical.href} />}
          {socialImageUrl && (
            <>
              <meta property="og:image" content={socialImageUrl} />
              <meta property="og:image:width" content="1200" />
              <meta property="og:image:height" content="630" />
              <meta property="og:image:type" content="image/png" />
              <meta property="og:image:alt" content={socialImageDescription} />
              <meta name="twitter:image" content={socialImageUrl} />
              <meta name="twitter:image:alt" content={socialImageDescription} />
            </>
          )}
          <meta name="twitter:card" content={socialImageUrl ? "summary_large_image" : "summary"} />
          <meta name="twitter:title" content={pageTitle} />
          <meta name="twitter:description" content={pageDescription} />
          {canonical && <link rel="canonical" href={canonical.href} />}
          {sitemapUrl && <link rel="sitemap" href={sitemapUrl} />}
          <link rel="alternate" hreflang={locale === "fr" ? "en" : "fr"} href={alternateUrl} />
          <link rel="alternate" hreflang={locale} href={currentUrl} />
          <link rel="alternate" hreflang="x-default" href={defaultUrl} />
        </>
      )
    }
  </head>
  <body>
    <script is:inline set:html={themeBootstrap} />
    {jsonLdSource && <script is:inline type="application/ld+json" set:html={jsonLdSource} />}
    <a class="skip-link" href="#main-content">{t.skipLink}</a>
    <Header {locale} {currentPath} {alternatePath} />
    <main id="main-content" class={mainClass}>
      <slot />
    </main>
    <Footer {locale} {currentPath} />
  </body>
</html>
